[Unit]
Description=Agent-as-User PTY Bridge Server
Documentation=https://github.com/AgentaaU/AaaU
After=network.target
Wants=network.target

[Service]
# aaau-server does not use sd_notify(3), so systemd should track its main PID
# directly instead of waiting for a readiness notification.
Type=simple
ExecStart=/usr/local/bin/aaau-server run --lock-file /run/aaau/aaau.lock --log-dir /var/lib/aaau
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# The bridge and agent both run as this dedicated account.  The bridge must
# be able to assign the human-control group to the socket it creates; the
# setgid runtime directory alone is not sufficient on every system for Unix
# socket nodes.  The bridge explicitly rejects connections from the agent UID
# on that socket, so this group is not an authorization bypass.
User=agent
Group=agent
SupplementaryGroups=aaau-users
RuntimeDirectory=aaau
RuntimeDirectoryMode=0710
StateDirectory=aaau
StateDirectoryMode=0700

# Reapply the human-control group and setgid bit after systemd creates the
# runtime directory.  This makes the directory traversable by authorized
# clients and makes newly-created sockets inherit aaau-users.
# The '+' prefix restricts these privileged setup steps to these two commands.
ExecStartPre=+/usr/bin/chgrp aaau-users /run/aaau
ExecStartPre=+/usr/bin/chmod 2710 /run/aaau

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aaau-server

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RemoveIPC=true
# Keep local/Internet sockets and interface discovery, while excluding packet
# sockets and unrelated protocol families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

# Allow PTY and socket operations
CapabilityBoundingSet=

# RuntimeDirectory= and StateDirectory= are writable automatically. Only the
# configured agent home needs an additional writable filesystem exception.
ReadWritePaths=/home/agent

[Install]
WantedBy=multi-user.target
