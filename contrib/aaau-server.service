[Unit]
Description=Agent-as-User PTY Bridge Server
Documentation=https://github.com/AgentaaU/AaaU
After=network.target
Wants=network.target

[Service]
# aaau-server does not use sd_notify(3), so systemd should track its main PID
# directly instead of waiting for a readiness notification.
Type=simple
ExecStart=/usr/local/bin/aaau-server run --lock-file /var/run/aaau/aaau.lock
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# Run as root (required for PTY management and user switching)
User=root
Group=root

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aaau-server

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# CAP_CHOWN is required when setting the owner/group of the two Unix sockets.
# The other capabilities are required for PTY management and user switching.
CapabilityBoundingSet=CAP_CHOWN CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE
AmbientCapabilities=CAP_CHOWN CAP_SYS_ADMIN CAP_SETUID CAP_SETGID CAP_AUDIT_WRITE

# Socket and lock file directory access
ReadWritePaths=/var/run/aaau /var/log/aaau /var/lib/agents

[Install]
WantedBy=multi-user.target
