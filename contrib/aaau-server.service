[Unit]
Description=Agent-as-User PTY Bridge Server
Documentation=https://github.com/AgentaaU/AaaU
After=network.target
Wants=network.target

[Service]
# aaau-server does not use sd_notify(3), so systemd should track its main PID
# directly instead of waiting for a readiness notification.
Type=simple
ExecStart=/usr/local/bin/aaau-server run --lock-file /run/aaau/aaau.lock --log-dir /var/lib/aaau
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# The bridge and agent both run as this dedicated account.  Some Linux
# filesystems do not propagate a setgid directory's group to Unix sockets, so
# the bridge needs this supplementary group only to set the socket group after
# bind(2).  The bridge rejects the agent UID on the human socket using peer
# credentials, so membership alone does not authorize agent connections.
User=agent
Group=agent
SupplementaryGroups=aaau-users
RuntimeDirectory=aaau
# The socket itself is group-restricted (0660, aaau-users).  Give other users
# traversal only here so group clients can reach that socket even on systems
# where RuntimeDirectory cannot be chgrp'd from an unprivileged service.
RuntimeDirectoryMode=0711
StateDirectory=aaau
StateDirectoryMode=0700

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aaau-server

# Security hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectKernelLogs=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RemoveIPC=true
# Keep local/Internet sockets and interface discovery, while excluding packet
# sockets and unrelated protocol families.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

# Allow PTY and socket operations
CapabilityBoundingSet=

# RuntimeDirectory= and StateDirectory= are writable automatically. Only the
# configured agent home needs an additional writable filesystem exception.
ReadWritePaths=/home/agent

[Install]
WantedBy=multi-user.target
