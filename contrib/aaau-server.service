[Unit]
Description=Agent-as-User PTY Bridge Server
Documentation=https://github.com/AgentaaU/AaaU
After=network.target
Wants=network.target

[Service]
Type=notify
ExecStart=/usr/local/bin/aaau-server run --lock-file /run/aaau/aaau.lock --log-dir /var/lib/aaau
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s

# The bridge and agent both run as this dedicated account.  The supplementary
# group lets the bridge create the human-control socket; agent UID is still
# explicitly denied on that socket by the bridge.
User=agent
Group=agent
SupplementaryGroups=aaau-users
RuntimeDirectory=aaau
RuntimeDirectoryMode=0755
StateDirectory=aaau
StateDirectoryMode=0750

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=aaau-server

# Security hardening
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

# Allow PTY and socket operations
CapabilityBoundingSet=

# Socket and lock file directory access
ReadWritePaths=/run/aaau /var/lib/aaau /var/lib/agents

[Install]
WantedBy=multi-user.target
